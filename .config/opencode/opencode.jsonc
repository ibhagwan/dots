{
  //
  // https://opencode.ai/docs/
  //
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "plan",
  "autoupdate": true,
  // "instructions": ["{env:HOME}/.config/opencode/INSTRUCTIONS.md"],
  "agent": {
    "build": { "color": "#3B82F6" },  // blue
    "plan":  { "color": "#8B5CF6" },  // purple
    "title": { "disable": false },
  },
  "provider": {
    "github-copilot": {
      "name": "GitHub Copilot",
      "options": {
        "apiKey": "{env:GITHUB_COPILOT_API_KEY}",
      },
    },
    "opencode-go": {
      "name": "Opencode Go",
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}",
      },
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nvidia",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}",
      },
      "models": {
        "qwen/qwen3.5-397b-a17b": { "name": "Qwen3.5 397B A17B Free" },
        "minimaxai/minimax-m3": { "name": "MiniMax M3 Free" },
        "z-ai/glm-5.2": { "name": "GLM 5.2" },
      },
    },
    "featherless": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Featherless",
      "options": {
        "baseURL": "https://api.featherless.ai/v1",
        "apiKey": "{env:FEATHERLESS_API_KEY}",
      },
      "models": {
        "zai-org/GLM-5.2": { "name": "GLM 5.2" },
        "moonshotai/Kimi-K2.6": { "name": "Kimi K2.6" },
        "moonshotai/Kimi-K2.7-Code": { "name": "Kimi K2.7 Code" },
        "MiniMaxAI/MiniMax-M3": { "name": "MiniMax M3" },
        "deepseek-ai/DeepSeek-V4-Flash": { "name": "DeepSeek V4 Flash" },
        "deepseek-ai/DeepSeek-V4-Pro": { "name": "DeepSeek V4 Pro" },
        "Qwen/Qwen3.6-35B-A3B": { "name": "Qwen3.6 35B A3B" },
        "XiaomiMiMo/MiMo-V2.5": { "name": "MiMo V2.5" },
      },
    },
    "cloudflare-workers-ai": {
      "options": {
        "accountId": "{env:CLOUDFLARE_ACCOUNT_ID}",
        "apiKey": "{env:CLOUDFLARE_API_TOKEN}",
      },
    },
    "cloudflare-ai-gateay": {
      "name": "Cloudflare AI Gateway",
      "options": {
        "gatewayId": "{env:CLOUDFLARE_GATEWAY_ID}",
        "accountId": "{env:CLOUDFLARE_ACCOUNT_ID}",
        "apiKey": "{env:CLOUDFLARE_API_TOKEN}",
      },
    },
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}",
        "baseURL": "https://openrouter.ai/api/v1",
      },
    },
    "anyapi": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AnyAPI",
      "options": {
        "baseURL": "https://api.anyapi.ai/v1",
        "apiKey": "{env:ANYAPI_API_KEY}",
      },
      "models": {
        "qwen/qwen3-coder:free": { "name": "Qwen3 Coder (free)" },
        "google/gemma-4-26b-a4b-it:free": { "name": "Gemma 4 (free)" },
      },
    },
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],
  // hermes-agent doesn't use a formatter
  // "formatter": { "ruff": { "disabled": true } },
}
